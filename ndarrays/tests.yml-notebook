- binary: ./notebook-non-paranoid
  tests:
    - name: example 1
      output: Square
      input: |
        3 5
        00100
        11111
        00100
    - name: example 2
      output: Line
      input: |
        4 5
        11111
        00000
        11111
        00000
    - name: example 3
      output: "?"
      input: |
        5 5
        00000
        00000
        11111
        00000
        00000
